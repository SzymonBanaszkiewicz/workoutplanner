<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="workout-planner-pu"
                      transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>org.example.persistence.entity.UserEnt</class>
        <class>org.example.persistence.entity.WorkoutEnt</class>
        <class>org.example.persistence.entity.WorkoutEntryEnt</class>
        <class>org.example.persistence.entity.ExerciseEnt</class>
        <class>org.example.persistence.entity.StrengthExerciseEnt</class>
        <class>org.example.persistence.entity.CardioExerciseEnt</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/nbddb"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="nbd"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="nbdpassword"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.connection.isolation"
                      value="2"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

            <property name="hibernate.jdbc.time_zone"
                      value="UTC"/>
        </properties>

    </persistence-unit>
</persistence>
